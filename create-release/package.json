{
  "name": "create-release",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "test": "node --test \"dist-test/**/*.test.js\"",
    "test:build": "tsc -p tsconfig.test.json",
    "check": "tsc --noEmit && npm run test:build && npm test && npm run build && git diff --exit-code dist/"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/node": "^26.1.2",
    "rollup": "^4.34.0",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3"
  }
}
